# ---- Backend (FastAPI) — copy to backend/.env ----
# SQLAlchemy URL. Local default uses your OS user via libpq; Docker overrides this.
DATABASE_URL=postgresql+psycopg://localhost:5432/puzzlecut
# Where uploads (uploads/<job_id>/) and outputs (generated/<job_id>/) are stored.
STORAGE_DIR=./data
# Comma-separated origins allowed to call the API (the Next.js app).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_MB=15
MAX_IMAGE_SIDE_PX=8192
RECOMMENDED_IMAGE_SIDE_PX=4096
MIN_IMAGE_SIDE_PX=64
WORKER_THREADS=2
# Photo -> 3D reconstruction: triposr | none. Device: auto (Apple GPU / CPU) | cpu | mps | cuda.
RECONSTRUCTION_BACKEND=triposr
RECONSTRUCTION_DEVICE=auto
RECONSTRUCTION_RESOLUTION=256
# Allow downloading the TripoSR weights (~1.7 GB, Hugging Face) on first use.
RECONSTRUCTION_ALLOW_DOWNLOAD=true
# AI background removal model for photos (rembg): isnet-general-use | none (~180 MB download).
SEGMENTATION_MODEL=isnet-general-use
# Upload limit for STL / OBJ / GLB / PLY models.
MAX_MODEL_UPLOAD_MB=50
LOG_LEVEL=INFO

# ---- Frontend (Next.js) — copy to frontend/.env.local ----
NEXT_PUBLIC_API_URL=http://localhost:8000
